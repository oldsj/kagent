{
  "anthropic": [
    {
      "name": "claude_git_instance_start",
      "match": {
        "match_type": "contains",
        "message": {
          "role": "user",
          "content": [{"type": "text", "text": "Publish a commit through the Git instance."}]
        }
      },
      "response": {
        "id": "msg_git_instance_bash",
        "type": "message",
        "role": "assistant",
        "content": [{
          "type": "tool_use",
          "id": "toolu_git_instance_bash",
          "name": "Bash",
          "input": {"command": "cd /data/workspace && git remote get-url origin && git remote get-url --push origin && git -c user.name=kagent-e2e -c user.email=e2e@kagent.invalid commit --allow-empty -q -m 'git instance e2e' && git push -q origin HEAD:refs/heads/git-instance-e2e && echo GIT_INSTANCE_PUSHED"}
        }],
        "model": "claude-sonnet-4-5",
        "stop_reason": "tool_use",
        "usage": {"input_tokens": 10, "output_tokens": 4}
      }
    },
    {
      "name": "claude_git_instance_bash_result",
      "match": {
        "match_type": "contains",
        "message": {
          "role": "user",
          "content": [{"type": "tool_result", "tool_use_id": "toolu_git_instance_bash"}]
        }
      },
      "response": {
        "id": "msg_git_instance_done",
        "type": "message",
        "role": "assistant",
        "content": [{"type": "text", "text": "GIT_INSTANCE_DONE"}],
        "model": "claude-sonnet-4-5",
        "stop_reason": "end_turn",
        "usage": {"input_tokens": 12, "output_tokens": 4}
      }
    },
    {
      "name": "claude_git_instance_auxiliary",
      "match": {
        "match_type": "contains",
        "message": {
          "role": "user",
          "content": [{"type": "text", "text": ""}]
        }
      },
      "response": {
        "id": "msg_git_instance_auxiliary",
        "type": "message",
        "role": "assistant",
        "content": [{"type": "text", "text": "OK"}],
        "model": "claude-sonnet-4-5",
        "stop_reason": "end_turn",
